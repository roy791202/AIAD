{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "uidesign-window",
  "description": "UI Editor／Viewer OS windows — IPC + window chrome (can leave main)",
  "windows": ["ui-editor", "ui-viewer"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-center",
    "host-default",
    "dispatch-default"
  ]
}
