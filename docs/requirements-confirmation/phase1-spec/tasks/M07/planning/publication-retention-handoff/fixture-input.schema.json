{
  "type": "object",
  "properties": {
    "request": {
      "$ref": "request.schema.json"
    },
    "attempt_id": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "index_proof_ref": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string"
        },
        "receipt_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "context_digest": {
          "type": "string"
        },
        "evidence_digest": {
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "receipt_id",
        "kind",
        "context_digest",
        "evidence_digest"
      ],
      "additionalProperties": false
    },
    "transition_key": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload_verified": {
      "type": "boolean"
    },
    "materials_verified": {
      "type": "boolean"
    },
    "index_outcome": {
      "type": "string",
      "enum": [
        "Committed",
        "Failed",
        "Unknown"
      ]
    },
    "root_outcome": {
      "type": "string",
      "enum": [
        "Transferred",
        "Deferred",
        "Unknown"
      ]
    },
    "issuer_record_available": {
      "type": "boolean"
    },
    "owner_generation": {
      "type": "string"
    },
    "live_revision": {
      "type": "string"
    },
    "captured_ack_requested": {
      "type": "boolean"
    }
  },
  "required": [
    "request",
    "attempt_id",
    "snapshot_id",
    "index_proof_ref",
    "transition_key",
    "payload_verified",
    "materials_verified",
    "index_outcome",
    "root_outcome",
    "issuer_record_available",
    "owner_generation",
    "live_revision",
    "captured_ack_requested"
  ],
  "additionalProperties": false
}
