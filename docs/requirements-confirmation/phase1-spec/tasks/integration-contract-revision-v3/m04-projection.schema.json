{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sga:cx-v3:m04:projection",
  "$defs": {
    "U64Decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20,
      "description": "Checked runtime u64 <=18446744073709551615; no JSON number or JS Number"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project_uuid": {
      "type": "string"
    },
    "document_uuid": {
      "type": "string"
    },
    "session_uuid": {
      "type": "string"
    },
    "generation": {
      "$ref": "#/$defs/U64Decimal"
    },
    "revision": {
      "$ref": "#/$defs/U64Decimal"
    },
    "format": {
      "type": "string"
    },
    "semantic_profile": {
      "type": "string"
    },
    "dirty": {
      "type": "boolean"
    },
    "can_mutate": {
      "type": "boolean"
    },
    "health": {
      "type": "string"
    },
    "pending_binding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "project_uuid",
    "document_uuid",
    "session_uuid",
    "generation",
    "revision",
    "format",
    "semantic_profile",
    "dirty",
    "can_mutate",
    "health",
    "pending_binding_ids",
    "blocked_capabilities"
  ]
}
