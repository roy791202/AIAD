  "responses": {
    "common": "{ok:true,value:<result>,replayed:bool} | {ok:false,error:{code:<listed>,details:<exact closed fields>},replayed:bool}; no simultaneous value/error. Only identical retained authorized request_id replay sets replayed=true; UI never replaces newer revision/generation from a replayed old result.",
    "BindingProjection": {
      "binding_ref": "UUID",
      "document_uuid": "existing trusted manifest UUID",
      "session_uuid": "server UUID",
      "owner_generation": "u64 string",
      "revision": "u64 string",
      "design_json": "C1 validated canonical JSON string",
      "dirty": "bool from S1",
      "can_edit": "bool from actual caller+writer+supported status",
      "unsupported": "[{node_id,type,reason}]",
      "selection": "nullable node ID ephemeral for this view",
      "persistence_ready": false
    },
    "Candidate": "{candidate_ref UUID, request_id UUID, captured_revision u64 string, unsupported:[...], installable bool}; no auto install",
    "InstallUndoTransfer": "BindingProjection; changed bool and history_depth u64 string on actual content mutation only",
    "Select": "{node_id nullable string,content_changed:false,revision u64 string}",
    "Preview": "{preview_session UUID,source_revision u64 string,expected_sequence u64 string,stale bool,mock_state:{node_id:typed value},capabilities:[node_id,allowed_action list]}; no native root or writer token",
    "Intent": "{consumed_sequence u64 string,next_sequence u64 string,mock_delta typed value,content_changed:false}; all error cases preserve sequence/state except explicit close/refresh lifecycle",
    "Close": "{closed:true,content_changed:false}"
  },
