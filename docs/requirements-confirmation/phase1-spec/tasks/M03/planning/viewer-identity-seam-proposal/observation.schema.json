{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "consumer": {
      "type": "string",
      "minLength": 1
    },
    "window_instance": {
      "type": "string",
      "minLength": 1
    },
    "project_uuid": {
      "type": "string",
      "minLength": 1
    },
    "root_instance": {
      "type": "string",
      "minLength": 1
    },
    "runtime_epoch": {
      "type": "string",
      "minLength": 1
    },
    "document_uuid": {
      "type": "string",
      "minLength": 1
    },
    "session_uuid": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "preview_session": {
      "type": "string",
      "minLength": 1
    },
    "native_live": {
      "type": "boolean"
    },
    "revoked": {
      "type": "boolean"
    }
  },
  "required": [
    "consumer",
    "window_instance",
    "project_uuid",
    "root_instance",
    "runtime_epoch",
    "document_uuid",
    "session_uuid",
    "generation",
    "preview_session",
    "native_live",
    "revoked"
  ],
  "additionalProperties": false
}
