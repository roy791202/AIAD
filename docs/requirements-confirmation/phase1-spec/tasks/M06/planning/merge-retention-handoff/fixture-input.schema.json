{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Bounded input closed at top; transition nested closure validated against exact central schema; mutation observations are candidate fixture fields, not adopted public DTO.",
  "type": "object",
  "properties": {
    "import_request": {
      "type": "object"
    },
    "import_receipt_ref": {
      "type": "object"
    },
    "mutation": {
      "type": "object"
    },
    "mutation_proof": {
      "type": "object"
    },
    "merge_publish": {
      "type": "array"
    },
    "merge_transfer": {
      "type": "array"
    },
    "undo_request": {
      "type": "object"
    },
    "undo_mutation": {
      "type": "object"
    },
    "undo_proof": {
      "type": "object"
    },
    "undo_publish": {
      "type": "array"
    },
    "undo_transfer": {
      "type": "array"
    },
    "commit_observation": {
      "enum": [
        "KnownNotAttempted",
        "Applied",
        "Unknown"
      ]
    },
    "root_observation": {
      "enum": [
        "Failure",
        "Verified",
        "Stale",
        "Unknown"
      ]
    },
    "perform_undo": {
      "type": "boolean"
    },
    "undo_observation": {
      "enum": [
        "Applied",
        "Unknown"
      ]
    },
    "undo_root_observation": {
      "enum": [
        "Failure",
        "Verified",
        "Stale",
        "Unknown"
      ]
    }
  },
  "required": [
    "import_request",
    "import_receipt_ref",
    "mutation",
    "mutation_proof",
    "merge_publish",
    "merge_transfer",
    "undo_request",
    "undo_mutation",
    "undo_proof",
    "undo_publish",
    "undo_transfer",
    "commit_observation",
    "root_observation",
    "perform_undo",
    "undo_observation",
    "undo_root_observation"
  ],
  "additionalProperties": false
}
