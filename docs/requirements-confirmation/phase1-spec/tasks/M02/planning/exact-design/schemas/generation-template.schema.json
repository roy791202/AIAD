{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "sgenaxis.generation-template"
    },
    "version": {
      "const": 1
    },
    "template_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "template_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "form": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "framework": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "has_ui": {
          "type": "boolean"
        }
      },
      "required": [
        "form",
        "platform",
        "language",
        "framework",
        "has_ui"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
            "description": "semantic checks component<=64, count<=16, reject dot/dotdot/reserved/terminal-dot/casefold or prefix collisions"
          },
          "product": {
            "enum": [
              "program",
              "ui_ux"
            ]
          },
          "template_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
            "description": "semantic checks component<=64, count<=16, reject dot/dotdot/reserved/terminal-dot/casefold or prefix collisions"
          },
          "source_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "encoding": {
            "const": "utf8-text"
          }
        },
        "required": [
          "relative_path",
          "product",
          "template_key",
          "source_digest",
          "encoding"
        ]
      }
    }
  },
  "required": [
    "schema",
    "version",
    "template_id",
    "template_version",
    "compatibility",
    "artifacts"
  ]
}