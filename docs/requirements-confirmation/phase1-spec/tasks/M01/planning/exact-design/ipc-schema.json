{
  "status": "PROPOSED_FOR_REVIEW",
  "request_schemas": {
    "project_wizard_begin": {
      "type": "object",
      "properties": {
        "parent_selection_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "name": {
