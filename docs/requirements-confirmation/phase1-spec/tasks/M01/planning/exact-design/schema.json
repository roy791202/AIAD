{
  "type": "object",
  "properties": {
    "schema": {
      "const": "eluslot.project-definition"
    },
    "schemaVersion": {
      "const": 1
    },
    "projectUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "definitionRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "purpose": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "draft",
        "defined"
      ]
    },
    "lastSavedStep": {
      "enum": [
        "basics",
        "delivery",
        "topology",
        "requirements",
        "technology_ui",
        "preview"
      ]
    },
    "deliveryTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "form": {
            "type": "object",
            "properties": {
              "state": {
                "enum": [
                  "unresolved",
                  "tentative",
                  "confirmed"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "state",
              "value"
            ],
            "additionalProperties": false
          },
          "platform": {
            "type": "object",
            "properties": {
              "state": {
                "enum": [
                  "unresolved",
                  "tentative",
                  "confirmed"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "state",
              "value"
            ],
            "additionalProperties": false
          },
          "host": {
            "type": "object",
            "properties": {
              "state": {
                "enum": [
                  "unresolved",
                  "tentative",
                  "confirmed"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "state",
              "value"
            ],
            "additionalProperties": false
          },
          "hostVersion": {
            "type": "object",
            "properties": {
              "state": {
                "enum": [
                  "unresolved",
                  "tentative",
                  "confirmed"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "state",
              "value"
            ],
            "additionalProperties": false
          },
          "language": {
            "type": "object",
            "properties": {
              "state": {
                "enum": [
                  "unresolved",
                  "tentative",
                  "confirmed"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "state",
              "value"
            ],
            "additionalProperties": false
          },
          "framework": {
            "type": "object",
            "properties": {
              "state": {
                "enum": [
                  "unresolved",
                  "tentative",
                  "confirmed"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "state",
              "value"
            ],
            "additionalProperties": false
          },
          "toolchain": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hasUi": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "form",
          "platform",
          "host",
          "hostVersion",
          "language",
          "framework",
          "toolchain",
          "hasUi"
        ],
        "additionalProperties": false
      }
    },
    "topology": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "unresolved",
            "tentative",
            "confirmed"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "value"
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "enum": [
              "unresolved",
              "tentative",
              "confirmed"
            ]
          }
        },
        "required": [
          "id",
          "intent",
          "acceptance",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "preferenceSource": {
      "enum": [
        "skip",
        "preset",
        "imported-copy"
      ]
    },
    "template": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sourceDigest"
      ],
      "additionalProperties": false
    },
    "openDecisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approvalRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "legacyRootKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "schemaVersion",
    "projectUuid",
    "definitionRevision",
    "name",
    "purpose",
    "mode",
    "lastSavedStep",
    "deliveryTargets",
    "topology",
    "requirements",
    "preferenceSource",
    "template",
    "openDecisions",
    "approvalRefs",
    "legacyRootKeys",
    "extensions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed ProjectDefinition v1"
}