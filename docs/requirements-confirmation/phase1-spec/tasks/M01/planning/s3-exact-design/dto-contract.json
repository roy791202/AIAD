  "responses": {
    "Envelope": {
      "success": "{ok:true,value:<command result>}",
      "failure": "{ok:false,error:{code:<listed error>,details:<exact fields>}}",
      "rules": "discriminated union, no simultaneous value/error; serde deny_unknown_fields on all closed DTOs; error precedence caller -> shape -> owner -> selection -> revision -> request reservation -> native revalidate -> S2 outcome -> authorized projection"
    },
    "Start": {
      "type": "object",
      "properties": {
        "owner_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "u64 range checked, never JS Number"
        }
      },
      "required": [
        "owner_id",
        "generation"
      ],
      "additionalProperties": false
    },
    "Selection": {
      "kind": "cancelled | selected",
      "selected_fields": [
        "selection_id UUID",
        "purpose enum",
        "display_path string"
      ],
      "cancelled_fields": []
    },
    "Projection": {
      "fields": [
        "owner_id UUID",
        "draft_id UUID",
        "project_uuid UUID",
        "revision u64 string",
        "persisted_revision nullable u64 string",
        "last_step six-step enum",
        "draft exact draft schema",
        "location_preview string",
        "mode Draft|Defined",
        "dirty bool",
        "missing_fields string[]",
        "generation_allowed false",
        "state EditingUnsaved|SavedDraft|SavingDraft|PartialProjectCreated|RecoveryRequired",
        "preference_plan {source:skip|preset|imported-copy,source_digest:nullable string}"
      ],
      "rules": "contains no native handles, trusted session key, raw authority context or next_binding; drafts cannot write identity/approvals/mode/baseline"
    },
    "Save": {
      "fields": [
        "request_id UUID",
        "operation save|finalize|adopt",
        "captured_revision u64 string",
        "replayed bool",
        "outcome {kind:Saved|DraftSavedMissingDecisions|PartialProjectCreated|RecoveryRequired|StoreError,fields:exact mapped payload}",
        "binding_status unchanged|bound|detached|committed_unbound",
        "projection nullable Projection"
      ],
      "success_payload": "DefinitionSaveReceipt maps every field except private next_binding; keep next_binding server-side. definition/creation/preferences/canonical_root included. Partial/RecoveryRequired map exact error fields and are never success/bound.",
      "projection_failure": "S2 committed proof retained, binding_status committed_unbound/detached; do not rewrite commit as failed unchanged"
    },
    "Cancel": "{revoked:true,detached_requests:UUID[]} (no FS mutation)",
    "Open": "{kind:Saved,projection:Projection} | {kind:Legacy,selection_id:UUID,canonical_root:string,portable_legacy_keys:string[],migration_required:true}; Legacy creates no draft/UUID/write until explicit adopt",
    "Get": "Projection; no mutation or persistence",
    "SetPreferences": "Projection after existing prepare_definition_preferences succeeds and apply_definition advances revision exactly once. Keep captured prepared plan server-side; imported JSON is data, not a filename. Invalid preset/import leaves prior draft/plan/revision unchanged. PreferenceSource in update must equal prepared plan source or InvalidRequest preference_plan_mismatch; user switches source only through set_preferences."
  },
